      "parameters": {
        "jsCode": "const text = $json.stdout || \"\";\nconst escaped = text.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\nreturn { text: escaped };"
