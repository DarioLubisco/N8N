  "nodes": [
    {
      "id": "wh-node-01",
      "name": "GitHub Webhook",
      "parameters": {
        "httpMethod": "POST",
        "path": "github-push-notion",
        "responseData": "allEntries",
        "responseMode": "onReceived"
      },
      "position": [
        200,
        300
      ],
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "webhookId": "e10cf30c-c352-4547-91cf-33ca3f1b354f"
    },
    {
      "id": "code-node-02",
      "name": "Extract Task IDs from Commits",
      "parameters": {
        "jsCode": "const payload = $input.first().json;\nconst commits = payload.body?.commits || [];\n\nconst taskPattern = /TASK-\\d+/gi;\nconst foundTasks = new Set();\n\nfor (const commit of commits) {\n  const msg = commit.message || '';\n  const matches = msg.match(taskPattern);\n  if (matches) {\n    matches.forEach(t => foundTasks.add(t.toUpperCase()));\n  }\n}\n\nconst repoName = payload.body?.repository?.name || 'unknown';\nconst branch = (payload.body?.ref || '').replace('refs/heads/', '');\nconst pusher = payload.body?.pusher?.name || 'unknown';\n\nif (foundTasks.size === 0) {\n  return [{ json: { found: false, message: 'No TASK-XX references in commits', repoName, branch, pusher } }];\n}\n\nreturn Array.from(foundTasks).map(taskId => ({\n  json: { found: true, taskId, taskNumber: parseInt(taskId.replace('TASK-', '')), repoName, branch, pusher }\n}));"
      },
      "position": [
        440,
        300
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "if-node-03",
      "name": "Filter - Only Found Tasks",
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "id": "cond-01",
              "leftValue": "={{ $json.found }}",
              "operator": {
                "operation": "equals",
                "type": "boolean"
              },
              "rightValue": true
            }
          ]
        }
      },
      "position": [
        680,
        300
      ],
      "type": "n8n-nodes-base.if",
      "typeVersion": 2
    },
    {
      "id": "http-node-04",
      "name": "Search Task in Notion",
      "parameters": {
        "body": "={\"filter\":{\"property\":\"ID\",\"unique_id\":{\"equals\":{{$json.taskNumber}}}}}",
        "contentType": "json",
