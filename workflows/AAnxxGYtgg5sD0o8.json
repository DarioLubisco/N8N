    {
      "id": "a1b2c3d4-1111-2222-3333-444455556666",
      "name": "Iniciar Ventana",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        300
      ],
      "parameters": {
        "jsCode": "// Inicializa el estado de la ventana de 2 horas.\n// Pasa un único item al splitInBatches con el estado inicial.\n// El loop itera mientras el item que vuelve tenga 'seguir=true'.\nconst ahora = Date.now();\nconst window_end = ahora + (2 * 60 * 60 * 1000); // +2h\n\nconst estado = {\n  inicio: ahora,\n  window_end,\n  iteraciones: 0,\n  procesados_total: 0,\n  escritos_total: 0,\n  motivo_parada: null,\n  seguir: true\n};\n\nreturn [{ json: estado }];"
      }
    },
    {
      "id": "b2c3d4e5-2222-3333-4444-555566667777",
      "name": "Loop Batches",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 1,
      "position": [
        520,
        300
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "c3d4e5f6-3333-4444-5555-666677778888",
      "name": "Check Tiempo Restante",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        740,
        380
      ],
      "parameters": {
        "jsCode": "// Recibe el estado del item actual (vía branch 1 del splitInBatches).\n// Verifica si quedan >=15 min de ventana. Si no, marca seguir=false\n// para cortar el loop en la próxima vuelta.\nconst state = $json;\nconst ahora = Date.now();\nconst restante_min = Math.floor((state.window_end - ahora) / 60000);\n\n// El estado puede venir con 'seguir' ya en false desde la iteración anterior\n// (porque el SSH marcó parar). En ese caso no hacer nada, dejar pasar para\n// que el SSH no se ejecute y el loop termine.\nif (!state.seguir) {\n  return [{ json: state }];\n}\n\nif (restante_min < 15) {\n  state.seguir = false;\n  state.motivo_parada = `tiempo_agotado (quedaban ${restante_min} min)`;\n  return [{ json: state }];\n}\n\nreturn [{ json: state }];"
      }
    },
    {
      "id": "374c7bf3-7262-4239-abf6-06d6b93dcebd",
      "name": "Ejecutar Batch (SSH)",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [
        940,
        380
      ],
      "parameters": {
        "resource": "command",
        "operation": "execute",
        "command": "cd \"/home/synapse/source/repos/Clasificacion Medicamentos\" && export DB_SERVER=\"100.94.5.108,49751\" && python3 -u orquestador_produccion.py --trigger-json '{\"TriggerID\":1,\"ProcessName\":\"MDM_Farmaceutico_Scraper\",\"CheckQuery\":\"SELECT COUNT(*) FROM Procurement.por_aprobacion_equivalencias WHERE estado_ciclo = '\\''ABIERTO'\\''\",\"ThresholdValue\":1}' --sync"
      },
      "credentials": {
        "sshPassword": {
          "id": "q9XQyJD7Uu17tWSl",
          "name": "[PROD] SSH - Debian WebServices"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000
    },
    {
      "id": "d4e5f6g7-4444-5555-6666-777788889999",
      "name": "Parse y Acumular",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1140,
        380
      ],
      "parameters": {
        "jsCode": "// El SSH devuelve stdout. La última línea válida es el JSON {status, procesados, escritos, intentados}.\n// Acumula contadores y decide si seguir iterando:\n//   - si status='skipped' o intentados=0 → seguir=false (no hay más ABIERTO)\n//   - si hubo error → seguir=false y propagar mensaje al estado\nconst state = $items('Check Tiempo Restante')[0].json;\nconst stdout = ($input.first().json.stdout || '').trim();\nconst stderr = ($input.first().json.stderr || '').trim();\nconst exitCode = $input.first().json.exitCode;\n\n// Extraer último JSON del stdout\nconst lines = stdout.split('\\n').filter(l => l.trim());\nlet resultado = null;\nfor (let i = lines.length - 1; i >= 0; i--) {\n  try {\n    const p = JSON.parse(lines[i]);\n    if (p.status && 'procesados' in p) { resultado = p; break; }\n  } catch (e) {}\n}\n\nif (!resultado) {\n  state.seguir = false;\n  state.motivo_parada = `error_batch_sin_json (exitCode=${exitCode}, stderr=${stderr.slice(0,200)})`;\n  state.iteraciones += 1;\n  return [{ json: state }];\n}\n\nstate.iteraciones += 1;\nstate.procesados_total += (resultado.procesados || 0);\nstate.escritos_total += (resultado.escritos || 0);\n\n// Si no hay más productos ABIERTO, cortar\nif (resultado.status === 'skipped' || resultado.intentados === 0) {\n  state.seguir = false;\n  state.motivo_parada = state.motivo_parada || 'sin_productos_ABIERTO';\n}\n\nreturn [{ json: state }];"
      }
    },
