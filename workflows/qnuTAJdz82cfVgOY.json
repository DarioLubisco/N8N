    {
      "credentials": {
        "microsoftSql": {
          "id": "1",
          "name": "EnterpriseAdmin_AMC"
        }
      },
      "id": "2",
      "name": "Query Stale Providers",
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT e.Proveedor, e.Workflow_ID, e.Tolerancia_Frescura_Horas, MAX(m.fecha_carga) as ultima_carga, DATEDIFF(hour, MAX(m.fecha_carga), GETDATE()) as horas_inactivo FROM Proveedores.ETL_Configuracion e LEFT JOIN Analitica.Mercado_Vivo m ON e.Proveedor_Alias = m.proveedor WHERE e.Activo = 1 GROUP BY e.Proveedor, e.Workflow_ID, e.Tolerancia_Frescura_Horas HAVING DATEDIFF(hour, MAX(m.fecha_carga), GETDATE()) > e.Tolerancia_Frescura_Horas"
      },
      "position": [
        450,
        300
      ],
      "type": "n8n-nodes-base.microsoftSql",
      "typeVersion": 1
    },
    {
      "id": "3",
      "name": "Any Stale?",
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.Proveedor ? true : false }}",
              "value2": true
            }
          ]
        }
      },
      "position": [
        650,
        300
      ],
      "type": "n8n-nodes-base.if",
      "typeVersion": 1
    },
    {
      "credentials": {
        "telegramApi": {
          "id": "1",
          "name": "Telegram AMC_Notificacion_bot"
        }
      },
      "id": "4",
      "name": "Telegram Alert",
      "parameters": {
        "chatId": "-1003531406167",
        "parseMode": "MarkdownV2",
        "text": "=🚨 *ALERTA DE FRESCURA ETL* 🚨\nEl proveedor *{{ $json.Proveedor }}* está desactualizado.\nTolerancia: {{ $json.Tolerancia_Frescura_Horas }}h\nHoras inactivo: {{ $json.horas_inactivo }}h\nÚltima carga: {{ $json.ultima_carga }}\n\nIniciando re-ejecución del flujo ({{ $json.Workflow_ID }})..."
      },
      "position": [
        850,
        150
      ],
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1
    },
    {
